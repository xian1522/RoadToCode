<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox styleClass="top-wrap">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="12.0" />
            </padding>
            <VBox styleClass="fieldset">
                <HBox fx:id="legend" alignment="CENTER_LEFT" spacing="4" styleClass="legend"
                      onMouseClicked="#onToggleCollapse">
                    <Label fx:id="legendCaret" text="▾" styleClass="legend-caret" />
                    <Label text="参数设置" styleClass="legend-title" />
                </HBox>
                <VBox fx:id="inputPanel" spacing="8" styleClass="fieldset-content">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label prefWidth="90.0" text="项目路径" />
                        <TextField fx:id="projectPathField" prefWidth="450" promptText="E:\myProject\spring-boot-2.6.x\spring-boot-project\spring-boot\src\main\java\org\springframework\boot\SpringApplication.java"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label prefWidth="90.0" text="类名" />
                        <TextField fx:id="classNameField" prefWidth="450" promptText="org.springframework.boot.SpringApplication"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label prefWidth="90.0" text="方法名" />
                        <TextField fx:id="methodNameField" prefWidth="180" promptText="run"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label prefWidth="90.0" text="参数名列表" />
                        <TextField fx:id="paramNamesField" prefWidth="300" promptText="primarySource, args" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Button fx:id="analyzeButton" defaultButton="true" onAction="#onAnalyze" text="解析" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </top>
    <center>
        <TreeView fx:id="treeView" />
    </center>
</BorderPane>
